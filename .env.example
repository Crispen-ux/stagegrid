# Postgres connection string used by the Prisma CLI (migrations) and Prisma Client at runtime.
# On Vercel this comes from the Postgres/Neon integration (POSTGRES_PRISMA_URL or POSTGRES_URL);
# any one of the three names is accepted by lib/db.ts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Portal (/portal) sign-in. Session tokens are signed with PORTAL_SESSION_SECRET — set a long random
# value on Vercel (npx vercel env add PORTAL_SESSION_SECRET production). Locally an unknown secret
# still works because sign-in goes through the seeded accounts in the database.
# PORTAL_PASSWORD=""
# PORTAL_SESSION_SECRET=""

# Passwords used only by `npm run db:seed` (scripts/seed-clients.js) when creating portal accounts.
# PORTAL_ADMIN_PASSWORD="SG-62Jzyw"
# ACME_PASSWORD="acme-portal-2026"
# NORTHWIND_PASSWORD="northwind-portal-2026"
