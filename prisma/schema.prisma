generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  company      String?
  passwordHash String
  role         String   @default("client")
  status       String   @default("pending")
  created      DateTime @default(now())

  contactMessages ContactMessage[]
  quoteRequests   QuoteRequest[]
  builderQuotes   BuilderQuote[]
  builderConfigs  BuilderConfig[]
  bookings        Booking[]
  quotes          Quote[]
  invoices        Invoice[]
  deliveries      Delivery[]
}

model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  company String?
  email   String
  phone   String?
  message String  @db.Text
  handled Boolean @default(false)
  created DateTime @default(now())

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model QuoteRequest {
  id         String    @id @default(cuid())
  reference  String    @unique
  eventType  String
  guestCount Int
  eventDate  DateTime? @db.Date
  venue      String?
  name       String
  email      String
  notes      String?   @db.Text
  status     String    @default("new")
  created    DateTime  @default(now())

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model BuilderQuote {
  id             String   @id @default(cuid())
  reference      String   @unique
  configuration  Json
  recommendation Json
  basket         Json
  estimateTotal  Int
  status         String   @default("new")
  created        DateTime @default(now())

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model BuilderConfig {
  id            String   @id @default(cuid())
  reference     String   @unique
  label         String?
  configuration Json
  created       DateTime @default(now())
  updated       DateTime @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

// ---- Portal modules managed by the admin (CRUD) -------------------------------

model Product {
  id                 String   @id @default(cuid())
  sku                String   @unique
  name               String
  category           String
  description        String   @default("")
  specs              Json?
  dailyRate          Int      @default(0)
  available          Boolean  @default(true)
  quantityAvailable  Int      @default(0)
  compatiblePackages Json?
  created            DateTime @default(now())
  updated            DateTime @updatedAt
}

model Booking {
  id             String    @id @default(cuid())
  reference      String    @unique
  eventName      String
  status         String    @default("confirmed")
  deliveryWindow String    @default("")
  eventDate      DateTime? @db.Date
  crewIds        Json?
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  created        DateTime  @default(now())
  updated        DateTime  @updatedAt

  @@index([clientId])
}

model Quote {
  id            String   @id @default(cuid())
  reference     String   @unique
  status        String   @default("draft")
  estimateTotal Int      @default(0)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  created       DateTime @default(now())
  updated       DateTime @updatedAt

  @@index([clientId])
}

model Invoice {
  id         String    @id @default(cuid())
  reference  String    @unique
  eventName  String
  amount     Int       @default(0)
  status     String    @default("draft")
  dueDate    DateTime? @db.Date
  bookingRef String?
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  @@index([clientId])
}

model CrewMember {
  id      String   @id @default(cuid())
  name    String
  role    String   @default("general")
  phone   String?
  active  Boolean  @default(true)
  created DateTime @default(now())
  updated DateTime @updatedAt
}

model Vehicle {
  id      String   @id @default(cuid())
  label   String   @unique
  status  String   @default("warehouse")
  driver  String?
  created DateTime @default(now())
  updated DateTime @updatedAt
}

model Asset {
  id          String   @id @default(cuid())
  serial      String   @unique
  equipmentId String
  status      String   @default("available")
  bookingRef  String?
  created     DateTime @default(now())
  updated     DateTime @updatedAt
}

model Delivery {
  id               String   @id @default(cuid())
  eventName        String
  truck            String
  driver           String
  leadTechnician   String
  currentLocation  String
  eta              String
  currentStage     String   @default("Warehouse")
  active           Boolean  @default(true)
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  created          DateTime @default(now())
  updated          DateTime @updatedAt

  @@index([clientId])
}
